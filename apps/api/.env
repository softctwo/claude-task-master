# 基础环境变量
NODE_ENV=development

# 数据库
DATABASE_URL=postgresql+asyncpg://resoft:resoft_dev@localhost:5432/resoft_studio

# Redis
REDIS_URL=redis://localhost:6379/0

# 安全
SECRET_KEY=resoft-dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 模型配置
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# 日志级别
LOG_LEVEL=info
